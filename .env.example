# Server
NODE_ENV=development
PORT=3000
# HOST: leave unset — local dev defaults to 127.0.0.1, the Docker image to 0.0.0.0.
LOG_LEVEL=info

# Budget data source: "static" (demo seeds, implicit) | "hackforfacts" (live transparenta.eu API)
# NOTE: the live dataset covers fiscal years up to ~2024 and its values differ
# from the official consolidated figures (see README "Surse de date").
DATA_SOURCE=static
HACK_FOR_FACTS_BASE_URL=https://api.transparenta.eu
HACK_FOR_FACTS_TIMEOUT_MS=20000
# Fiscal year queried from the upstream dataset
HACK_FOR_FACTS_YEAR=2024

# INS data source: "static" (demo seeds) | "insloader" (transparenta-eu-ins-loader) | "eurostat" (live Eurostat equivalents)
DATA_SOURCE_INS=static
INS_LOADER_BASE_URL=http://localhost:3002
INS_LOADER_TIMEOUT_MS=3000

# Companii de stat (companiidestat.ro public snapshot API)
SOE_BASE_URL=https://companiidestat.ro
SOE_TIMEOUT_MS=15000

# Macro (Eurostat HICP/șomaj + BCE curs)
MACRO_TIMEOUT_MS=15000

# Buget adoptat (MFP datasets pe data.gov.ro, CKAN)
CKAN_BASE_URL=https://data.gov.ro
CKAN_TIMEOUT_MS=20000

# CORS (comma-separated origins: dev server + docker compose frontend)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
